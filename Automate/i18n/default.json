{
    /*********
    ** Generic Mod Config Menu UI
    *********/
    // main options
    "config.title.main-options": "Main options",
    "config.enabled.name": "Enabled",
    "config.enabled.desc": "Whether to enable Automate features. If this is disabled, no machines will be automated and the overlay won't appear.",
    "config.use-event-based-automation.name": "Event-based automation",
    "config.use-event-based-automation.desc": "If enabled (recommended), automation runs in response to game events (machine requests, chest contents changing) instead of a fixed interval; usually faster and much less overhead on dense farms. Disable to fall back to the fixed interval below if your setup doesn't get along with it.",
    "config.overwrite-automation-delay.name": "Overwrite automation delay",
    "config.overwrite-automation-delay.desc": "Whether Action delay (seconds) below actually takes effect. If disabled (default), it's locked to 7 seconds regardless of what you set, so upgrading a Power Relay stays the main way to speed up automation. Enable to set your own value instead.",
    "config.action-delay-seconds.name": "Action delay (seconds)",
    "config.action-delay-seconds.desc": "Only takes effect if Overwrite automation delay above is enabled. How many real-time seconds a group waits between committing each machine/container's own push or pull, once it's already committed as many as Actions per delay window allows. Applies in BOTH interval mode and event-based mode. Set to 0 to disable (acts instantly instead).",
    "config.overwrite-automation-actions.name": "Overwrite automation actions",
    "config.overwrite-automation-actions.desc": "Whether Actions per delay window below actually takes effect. If disabled (default), it's locked to 1 regardless of what you set, so upgrading a Power Relay stays the main way to increase it. Enable to set your own value instead.",
    "config.actions-per-delay-window.name": "Actions per delay window",
    "config.actions-per-delay-window.desc": "Only takes effect if Overwrite automation actions above is enabled. How many machine/container actions a group may commit within one Action Delay window before the rest have to wait for the next one. Set to 0 for unlimited. Has no effect when Action Delay is 0.",
    "config.animated-item-transfers.name": "Animated item transfers",
    "config.animated-item-transfers.desc": "Whether a container's lid pops open and shows a flying item with sound whenever an item enters or leaves through automation. Only ever plays in a location a player is actually standing in (this is only a visuals/audio effect).",
    "config.automation-interval.name": "Automation interval",
    "config.automation-interval.desc": "Only used when event-based automation above is disabled. The number of ticks between each automation process (60 for once per second, 120 for every two seconds, etc).",
    "config.min-minutes-for-fairy-dust.name": "Min minutes for fairy dust",
    "config.min-minutes-for-fairy-dust.desc": "The minimum machine processing time in minutes for which to apply fairy dust. For example, setting this to 30 minutes means fairy dust won't be applied if the machine would finish in 20 minutes without it.",
    "config.automation-experience-percent.name": "Automation experience %",
    "config.automation-experience-percent.desc": "What percentage of the normal skill experience is granted when Automate collects output automatically, instead of you collecting it by hand. Set to 0 for no experience from automation (the default), or 100 for the same experience as collecting it yourself.",
    "config.toggle-overlay-key.name": "Toggle overlay key",
    "config.toggle-overlay-key.desc": "The keys which toggle the automation overlay.",
    "config.warn-for-missing-bridge-mod.name": "Warn for missing bridge mod",
    "config.warn-for-missing-bridge-mod.desc": "Whether to log a warning on startup if you installed a custom-machine mod that requires a separate compatibility patch which isn't installed.",
    "config.power-required-machines-enabled.name": "Power-required machines",
    "config.power-required-machines-enabled.desc": "Whether certain high-value machines (Crystalarium, Auto-Grabber, Auto-Petter, Heavy Furnace, and others listed in the mod's config file) only automate while their own tile is within power range, instead of automating anywhere like other machines. Enabled by default as a deliberate balance choice.",
    "config.skip-cranking-minigame.name": "Skip cranking minigame",
    "config.skip-cranking-minigame.desc": "Enable to remove manual cranking minigame for all Cranked Power Coils.",
    "config.connected-machine-location-power-callouts.name": "Unpowered machine location callout",
    "config.connected-machine-location-power-callouts.desc": "Trigger callout for power-required machines that are connected to an active group but have NO power, gives general location of said machine",
    "config.connected-machine-location-power-callout-interval-seconds.name": "Callout repeat interval (seconds)",
    "config.connected-machine-location-power-callout-interval-seconds.desc": "Only used when Unpowered machine location callout above is enabled. How often, in real-world seconds, the location callout repeats for as long as a power-required machine remains without power.",
    "config.overwrite-power-grid-capacity.name": "Overwrite power grid capacity",
    "config.overwrite-power-grid-capacity.desc": "Force the total Power Grid capacity to the fixed value below, instead of the normal starting Power Grid (4) plus whatever capacity Power Silos have earned so far.",
    "config.power-grid-capacity-override.name": "Power grid capacity override",
    "config.power-grid-capacity-override.desc": "Only takes effect if Overwrite power grid capacity above is enabled. The fixed total Power Coil capacity to use instead (101 means infinite capacity).",

