{
    /*********
    ** Generic Mod Config Menu UI
    *********/
    // main options
    "config.title.main-options": "Opções Principais",
    "config.enabled.name": "Ativado",
    "config.enabled.desc": "Define se os recursos do Automate devem ser ativados. Se desativado, nenhuma máquina será automatizada e a sobreposição não aparecerá.",
    "config.use-event-based-automation.name": "Automação baseada em eventos",
    "config.use-event-based-automation.desc": "Se ativado (recomendado), a automação é executada em resposta aos eventos do jogo (solicitações de máquinas, alterações no conteúdo dos baús) em vez de seguir um intervalo fixo; geralmente é mais rápida e exige muito menos processamento em fazendas com muitos objetos. Desative para voltar ao intervalo fixo abaixo caso sua configuração não funcione bem com esse sistema.",
    "config.overwrite-automation-delay.name": "Substituir atraso da automação",
    "config.overwrite-automation-delay.desc": "Define se o Atraso da ação (segundos) abaixo realmente terá efeito. Se desativado (padrão), ele ficará fixo em 7 segundos, independentemente do valor definido, fazendo com que aprimorar um Relé de Automação continue sendo a principal forma de acelerar a automação. Ative para definir seu próprio valor.",
    "config.action-delay-seconds.name": "Atraso da ação (segundos)",
    "config.action-delay-seconds.desc": "Só terá efeito se a opção Substituir atraso da automação acima estiver ativada. Define quantos segundos em tempo real um grupo aguarda entre cada ação de inserção ou retirada de uma máquina ou recipiente, depois de já ter realizado a quantidade de ações permitida por janela de atraso. Aplica-se tanto ao modo por intervalo quanto ao modo baseado em eventos. Defina como 0 para desativar (as ações serão realizadas instantaneamente).",
    "config.overwrite-automation-actions.name": "Substituir ações da automação",
    "config.overwrite-automation-actions.desc": "Define se a opção Ações por janela de atraso abaixo realmente terá efeito. Se desativada (padrão), ficará fixada em 1, independentemente do valor definido, fazendo com que aprimorar um Relé de Automação continue sendo a principal forma de aumentar essa quantidade. Ative para definir seu próprio valor.",
    "config.actions-per-delay-window.name": "Ações por janela de atraso",
    "config.actions-per-delay-window.desc": "Só terá efeito se a opção Substituir ações da automação acima estiver ativada. Define quantas ações de máquinas/recipientes um grupo pode realizar dentro de uma única janela de Atraso da ação antes que as demais tenham que aguardar a próxima janela. Defina como 0 para ilimitado. Não tem efeito quando o Atraso da ação está definido como 0.",
    "config.animated-item-transfers.name": "Transferências de itens animadas",
    "config.animated-item-transfers.desc": "Define se a tampa de um recipiente se abrirá e exibirá um item voando, acompanhado de som, sempre que um item entrar ou sair por meio da automação. O efeito só será reproduzido no local onde um jogador estiver de fato presente (é apenas um efeito visual/sonoro).",
    "config.automation-interval.name": "Intervalo da automação",
    "config.automation-interval.desc": "Usado apenas quando a automação baseada em eventos acima estiver desativada. Define o número de ticks entre cada processo de automação (60 para uma vez por segundo, 120 para a cada dois segundos etc.).",
    "config.min-minutes-for-fairy-dust.name": "Tempo mínimo para Pó de Fada",
    "config.min-minutes-for-fairy-dust.desc": "Define o tempo mínimo de processamento da máquina, em minutos, necessário para aplicar Pó de Fada. Por exemplo, definir como 30 minutos significa que o Pó de Fada não será aplicado se a máquina terminasse em 20 minutos sem ele.",
    "config.automation-experience-percent.name": "% de experiência da automação",
    "config.automation-experience-percent.desc": "Define qual porcentagem da experiência normal da habilidade é concedida quando o Automate coleta a produção automaticamente, em vez de você coletá-la manualmente. Defina como 0 para não receber experiência pela automação (padrão) ou 100 para receber a mesma experiência de quando você coleta a produção pessoalmente.",
    "config.toggle-overlay-key.name": "Tecla da sobreposição",
    "config.toggle-overlay-key.desc": "As teclas usadas para ativar ou desativar a sobreposição de automação.",
    "config.warn-for-missing-bridge-mod.name": "Avisar sobre mod de integração ausente",
    "config.warn-for-missing-bridge-mod.desc": "Define se um aviso deve ser registrado ao iniciar o jogo caso você tenha instalado um mod de máquinas personalizadas que exige um patch de compatibilidade separado que não está instalado.",
    "config.power-required-machines-enabled.name": "Máquinas que exigem energia",
    "config.power-required-machines-enabled.desc": "Define se determinadas máquinas de alto valor (Cristalário, Coletor Automático, Afagador Automático, Fornalha Pesada e outras listadas no arquivo de configuração do mod) só devem ser automatizadas enquanto o próprio espaço onde estão posicionadas estiver dentro do alcance de energia, em vez de serem automatizadas em qualquer lugar como as outras máquinas. Ativado por padrão como uma escolha deliberada de balanceamento.",
    "config.skip-cranking-minigame.name": "Pular o minijogo de girar a manivela",
    "config.skip-cranking-minigame.desc": "Ative para remover o minijogo de girar a manivela de todas as Bobinas de Energia de Manivela.",    
    "config.connected-machine-location-power-callouts.name": "Aviso de localização de máquina sem energia",
    "config.connected-machine-location-power-callouts.desc": "Ativa um aviso para máquinas que exigem energia, conectadas a um grupo ativo, mas que NÃO possuem energia, informando a localização aproximada da máquina.",
    "config.connected-machine-location-power-callout-interval-seconds.name": "Intervalo entre avisos (segundos)",
    "config.connected-machine-location-power-callout-interval-seconds.desc": "Usado apenas quando a opção Aviso de localização de máquina sem energia acima estiver ativada. Define com que frequência, em segundos reais, o aviso de localização será repetido enquanto uma máquina que exige energia permanecer sem energia.",
    "config.overwrite-power-grid-capacity.name": "Substituir capacidade da rede elétrica",
    "config.overwrite-power-grid-capacity.desc": "Força a capacidade total da Rede Elétrica para o valor fixo abaixo, em vez de usar a Rede Elétrica inicial normal (4) mais a capacidade obtida até o momento pelos Silos de Energia.",
    "config.power-grid-capacity-override.name": "Substituição da capacidade da rede elétrica",
    "config.power-grid-capacity-override.desc": "Só terá efeito se a opção Substituir capacidade da rede elétrica acima estiver ativada. Define a capacidade total fixa de Bobinas de Energia a ser usada no lugar da normal (101 significa capacidade infinita).",

